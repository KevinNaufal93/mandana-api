NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mandana
DATABASE_PASSWORD=mandana_secret
DATABASE_NAME=mandana_db

# JWT — use long random strings in production (min 32 chars)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3 object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=mandana_minio
S3_SECRET_KEY=mandana_minio_secret
S3_BUCKET=assets
S3_FORCE_PATH_STYLE=true

# Public base URL for media — dev: http://localhost:9000/<bucket>
# In production: replace with your CDN base URL (e.g. https://cdn.mandana.com/assets)
MEDIA_PUBLIC_URL=http://localhost:9000/assets
