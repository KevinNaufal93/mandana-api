NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mandana
DATABASE_PASSWORD=mandana_secret
DATABASE_NAME=mandana_db

# JWT — use long random strings in production (min 32 chars)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Seed (used by src/database/seeds/seed.ts)
SEED_ADMIN_EMAIL=admin@mandana.com
SEED_ADMIN_PASSWORD=Admin1234!
