# =========================================================================
# Production/testing env for the EC2 + CloudFront + S3 deployment.
# Copy to `.env` ON THE BOX and fill in real values. Never commit real secrets.
#   cp .env.production.example .env   (then edit)
# =========================================================================

NODE_ENV=production
PORT=3000

# --- PostgreSQL (runs as the "postgres" compose service) ---
# DATABASE_HOST is overridden to "postgres" by docker-compose.prod.yml.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=mandana
DATABASE_PASSWORD=<STRONG_DB_PASSWORD>
DATABASE_NAME=mandana_db

# --- JWT --- generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=<64_HEX_CHARS>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<64_HEX_CHARS>
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis (runs as the "redis" compose service) ---
# REDIS_HOST is overridden to "redis" by docker-compose.prod.yml.
REDIS_HOST=redis
REDIS_PORT=6379

# --- Real AWS S3 (public-read bucket) ---
# Point the SDK endpoint at the regional S3 endpoint; virtual-hosted style.
S3_ENDPOINT=https://s3.<region>.amazonaws.com
S3_REGION=<region>                 # e.g. ap-southeast-3 (Jakarta) / ap-southeast-1 (Singapore)
S3_ACCESS_KEY=<IAM_ACCESS_KEY_ID>
S3_SECRET_KEY=<IAM_SECRET_ACCESS_KEY>
S3_BUCKET=<BUCKET_NAME>
S3_FORCE_PATH_STYLE=false

# Public base URL browsers use to load media (virtual-hosted-style bucket URL).
MEDIA_PUBLIC_URL=https://<BUCKET_NAME>.s3.<region>.amazonaws.com

# --- On-demand ISR revalidation webhook to mandana-web --- generate with: openssl rand -hex 32
# Both optional — omit to disable (mandana-web's own 300s time-based ISR still
# works without this, just slower). REVALIDATE_SECRET must be the exact same
# value as REVALIDATE_SECRET in mandana-web's deployed env (Amplify Hosting
# console) — the names don't need to match, only the value. Use the real
# deployed mandana-web domain over https:// — this secret travels in a plain
# request header.
MANDANA_WEB_BASE_URL=https://<mandana-web-domain>
REVALIDATE_SECRET=<64_HEX_CHARS>
